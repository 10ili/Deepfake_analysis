@Deepfake_analysis_HostAddress = http://localhost:5075
# Сначала выполните оба запроса входа: токены из ответов подставятся в остальные запросы сами.
@AdminToken = {{adminLogin.response.body.$.token}}
@UserToken = {{userLogin.response.body.$.token}}

### Вход администратора
# @name adminLogin
POST {{Deepfake_analysis_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

### Вход обычного пользователя
# @name userLogin
POST {{Deepfake_analysis_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "login": "user",
  "password": "user123"
}

### 401: отчёт без токена
GET {{Deepfake_analysis_HostAddress}}/api/reports/detectors

### 403: запуск анализа с токеном обычного пользователя
POST {{Deepfake_analysis_HostAddress}}/api/analyses
Authorization: Bearer {{UserToken}}
Content-Type: application/json

{
  "imageId": 1,
  "detectorId": 1
}

### Изображения
GET {{Deepfake_analysis_HostAddress}}/api/images
Accept: application/json

###
GET {{Deepfake_analysis_HostAddress}}/api/images?extension=png
Accept: application/json

### Загрузка файла (form-data, поле file)
POST {{Deepfake_analysis_HostAddress}}/api/images
Authorization: Bearer {{AdminToken}}
Content-Type: multipart/form-data; boundary=ImageBoundary

--ImageBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpg"
Content-Type: image/jpeg

< ../../postman/images/sample.jpg
--ImageBoundary--

### Сам файл изображения
GET {{Deepfake_analysis_HostAddress}}/api/images/1/file

### Переименование (расширение менять нельзя)
PUT {{Deepfake_analysis_HostAddress}}/api/images/1
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "fileName": "test_photo.jpg"
}

###
DELETE {{Deepfake_analysis_HostAddress}}/api/images/1
Authorization: Bearer {{AdminToken}}

### Детекторы
GET {{Deepfake_analysis_HostAddress}}/api/detectors?active=true
Accept: application/json

###
POST {{Deepfake_analysis_HostAddress}}/api/detectors
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "EfficientNet-B3 (строгий порог)",
  "model": "EfficientNetB3",
  "threshold": 0.8,
  "isActive": true
}

###
PUT {{Deepfake_analysis_HostAddress}}/api/detectors/4
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "EfficientNet-B3 (строгий порог)",
  "model": "EfficientNetB3",
  "threshold": 0.9,
  "isActive": true
}

###
DELETE {{Deepfake_analysis_HostAddress}}/api/detectors/4
Authorization: Bearer {{AdminToken}}

### Запуск анализа: ответ 202 сразу, расчёт идёт в фоне
POST {{Deepfake_analysis_HostAddress}}/api/analyses
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "imageId": 1,
  "detectorId": 1
}

### Результат (пока Status = Queued или Running — повторите позже)
GET {{Deepfake_analysis_HostAddress}}/api/analyses/1
Accept: application/json

###
GET {{Deepfake_analysis_HostAddress}}/api/analyses?status=Completed&verdict=Generated
Accept: application/json

### Тепловая карта PNG (с ?overlay=true — поверх картинки)
GET {{Deepfake_analysis_HostAddress}}/api/analyses/1/heatmap?overlay=true

###
DELETE {{Deepfake_analysis_HostAddress}}/api/analyses/1
Authorization: Bearer {{AdminToken}}

### Отчёты
GET {{Deepfake_analysis_HostAddress}}/api/reports/analyses
Authorization: Bearer {{UserToken}}
Accept: application/json

###
GET {{Deepfake_analysis_HostAddress}}/api/reports/detectors
Authorization: Bearer {{UserToken}}
Accept: application/json

###
GET {{Deepfake_analysis_HostAddress}}/api/reports/images
Authorization: Bearer {{UserToken}}
Accept: application/json

###
GET {{Deepfake_analysis_HostAddress}}/api/reports/disagreements
Authorization: Bearer {{UserToken}}
Accept: application/json

###
