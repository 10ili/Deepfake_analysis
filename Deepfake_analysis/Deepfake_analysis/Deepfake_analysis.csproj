<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- libtorch есть только 64-битная -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- База данных SQLite через Entity Framework Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Нейросети. Версии связаны: TorchSharp 0.107.0 собран под libtorch 2.10.0. -->
    <PackageReference Include="TorchSharp" Version="0.107.0" />
    <!-- Только сборка для Windows (~80 МБ); пакет TorchSharp-cpu тянул бы ещё Linux и macOS. -->
    <PackageReference Include="libtorch-cpu-win-x64" Version="2.10.0" />
    <!-- Чтение картинок и операции тепловой карты. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- Модель CatBoost в формате ONNX. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <!--
    Файлы моделей при публикации кладутся в папку models рядом с exe (пути из appsettings.json).
    Берутся из training/checkpoints. При обычной сборке не копируются: в режиме разработки
    модели читаются прямо из training/checkpoints (appsettings.Development.json).
  -->
  <PropertyGroup>
    <CheckpointsDir>$(MSBuildProjectDirectory)\..\..\training\checkpoints\</CheckpointsDir>
  </PropertyGroup>

  <ItemGroup>
    <ModelFile Include="$(CheckpointsDir)efficientnet_b3\efficientnet_b3.torchscript.pt" />
    <ModelFile Include="$(CheckpointsDir)resnet50\resnet50.torchscript.pt" />
    <ModelFile Include="$(CheckpointsDir)resnet50_catboost\resnet50_features.torchscript.pt" />
    <ModelFile Include="$(CheckpointsDir)resnet50_catboost\resnet50_catboost.onnx" />
  </ItemGroup>

  <!-- Выполняется при публикации: добавляет модели к списку файлов, которые попадут в папку публикации. -->
  <Target Name="PublishModels" AfterTargets="ComputeResolvedFilesToPublishList">
    <Warning Condition="!Exists('%(ModelFile.FullPath)')"
             Text="Файл модели не найден и не попадёт в публикацию: %(ModelFile.FullPath)" />
    <ItemGroup>
      <!-- ExcludeFromSingleFile: модели остаются отдельными файлами, а не вшиваются внутрь exe. -->
      <ResolvedFileToPublish Include="@(ModelFile)" Condition="Exists('%(FullPath)')"
                             RelativePath="models\%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
