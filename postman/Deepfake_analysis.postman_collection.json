    {
      "key": "baseUrl",
      "value": "http://localhost:5075"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "tokensIssuedAt",
      "value": "0"
    },
