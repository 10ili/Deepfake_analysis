{
  "info": {
    "_postman_id": "f37099a6-201b-4665-bc96-317d9d918d13",
    "name": "Deepfake analysis API",
    "description": "Запросы для проверки Web API распознавания сгенерированных изображений.\n\nТокены получаются автоматически перед первым запросом и хранятся в переменных коллекции. Коллекцию можно запустить целиком (Run collection): запросы идут в нужном порядке.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Авторизация",
      "description": "Получение токенов. Токены сами сохраняются в переменные коллекции adminToken и userToken.",
      "item": [
        {
          "name": "Вход администратора",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"adminToken\", pm.response.json().token);",
                  "    pm.test(\"Роль Admin\", function () {",
                  "        pm.expect(pm.response.json().role).to.eql(\"Admin\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
