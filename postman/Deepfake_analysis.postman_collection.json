  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Автовход: если токенов ещё нет или они старше 50 минут (живут 60),",
          "// перед запросом получаем новые. Поэтому любой запрос можно выполнять отдельно.",
          "const issuedAt = Number(pm.collectionVariables.get(\"tokensIssuedAt\") || 0);",
          "const fresh = Date.now() - issuedAt < 50 * 60 * 1000;",
          "const isLoginRequest = pm.request.url.getPath().endsWith(\"/auth/login\");",
          "",
          "function login(user, password, variable) {",
          "    pm.sendRequest({",
          "        url: pm.collectionVariables.get(\"baseUrl\") + \"/api/auth/login\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\" },",
          "        body: { mode: \"raw\", raw: JSON.stringify({ login: user, password: password }) }",
          "    }, function (err, res) {",
          "        if (err || res.code !== 200) {",
          "            console.error(\"Автовход не удался для \" + user + \". Запущен ли сервер по адресу baseUrl?\");",
          "            return;",
          "        }",
          "        pm.collectionVariables.set(variable, res.json().token);",
          "        pm.collectionVariables.set(\"tokensIssuedAt\", Date.now());",
          "    });",
          "}",
          "",
          "if (!fresh && !isLoginRequest) {",
          "    login(\"admin\", \"admin123\", \"adminToken\");",
          "    login(\"user\", \"user123\", \"userToken\");",
          "}"
        ]
      }
    }
  ],
